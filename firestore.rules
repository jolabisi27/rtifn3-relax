rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public write access for supporters & groups registration, and read access for dashboard
    match /voters/{voterId} {
      allow read, write: if true;
    }
    match /support_groups/{groupId} {
      allow read, write: if true;
    }
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
